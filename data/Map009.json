{"id":1,"name":"Катсцена","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["Actor1",4,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["Приветствую! Кем будешь, куда путь держишь?"]},{"code":101,"indent":0,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":0,"parameters":["День добрый! Я Фроск, Еду до Валадилены, путь "]},{"code":401,"indent":0,"parameters":["будет неблизкий."]},{"code":101,"indent":0,"parameters":["Actor1",2,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["Ого, вы прямо до конечной едете, что же вас "]},{"code":401,"indent":0,"parameters":["заставило туда отправиться?"]},{"code":101,"indent":0,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Знаете, я понял, что мне становится скучно "]},{"code":401,"indent":0,"parameters":["жить, хочется всё поменять, надоели эти серые "]},{"code":401,"indent":0,"parameters":["будни."]},{"code":101,"indent":0,"parameters":["Actor1",2,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["О-о-о, серьёзное дело, желаю удачи!"]},{"code":101,"indent":0,"parameters":["Actor1",4,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["Да, это даже хорошо, полезно так менять "]},{"code":401,"indent":0,"parameters":["обстановку: и мир повидаешь, и в новых "]},{"code":401,"indent":0,"parameters":["обстоятельствах окажешься."]},{"code":101,"indent":0,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Да, я тоже так думаю, а вы куда едете?"]},{"code":101,"indent":0,"parameters":["Actor1",4,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["А мы ученые, едем в Ветроград, у нас там будет "]},{"code":401,"indent":0,"parameters":["конференция, будем выступать с докладом о новых "]},{"code":401,"indent":0,"parameters":["материалах и возможностях для человечества."]},{"code":101,"indent":0,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Ого, приятно ехать с такими людьми в одном "]},{"code":401,"indent":0,"parameters":["поезде, вы, наверное, много сил на это "]},{"code":401,"indent":0,"parameters":["потратили, довольны результатами?"]},{"code":101,"indent":0,"parameters":["Actor1",2,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["Сил было потрачено немало, результат нас "]},{"code":401,"indent":0,"parameters":["порадовал, единственное, о чем переживаем, так "]},{"code":401,"indent":0,"parameters":["это о защите наших идей. "]},{"code":101,"indent":0,"parameters":["Actor1",2,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["Закрадываются мысли, что организаторы просто "]},{"code":401,"indent":0,"parameters":["хотят украсть наши идеи и реализовать от своего "]},{"code":401,"indent":0,"parameters":["лица, поэтому рассказывать будем осторожно."]},{"code":101,"indent":0,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Это вы правильно, я бы тоже так сделал, сами "]},{"code":401,"indent":0,"parameters":["понимаете, время такое."]},{"code":101,"indent":0,"parameters":["Actor1",2,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["Да, полностью согласны."]},{"code":101,"indent":0,"parameters":["Actor1",4,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["Вы курите? Мы с товарищем отойдем подышать "]},{"code":401,"indent":0,"parameters":["ненадолго, вы с нами?"]},{"code":101,"indent":0,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Нет, я не курю."]},{"code":101,"indent":0,"parameters":["Actor1",4,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["Это вы правильно, я вот всё пытаюсь бросить, но "]},{"code":401,"indent":0,"parameters":["пока не получается."]},{"code":101,"indent":0,"parameters":["Actor1",4,2,2,"Сосед по плацкарту"]},{"code":401,"indent":0,"parameters":["Ладно, увидимся позже!"]},{"code":230,"indent":0,"parameters":[180]},{"code":201,"indent":0,"parameters":[0,10,6,4,0,2]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":9},

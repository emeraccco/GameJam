"вагонах, совсем их не понимаю."]},{"code":101,"indent":0,"parameters":["Actor1",0,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Мне кажется, ты их прекрасно понимаешь, ведь ты "]},{"code":401,"indent":0,"parameters":["тоже так тут живёшь, не заметил?"]},{"code":101,"indent":0,"parameters":["Actor1",4,0,2,"Тодд"]},{"code":401,"indent":0,"parameters":["Да не, я тут ненадолго, вот все дела закончу и "]},{"code":401,"indent":0,"parameters":["дёрну этот стоп-кран."]},{"code":101,"indent":0,"parameters":["Actor1",0,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Ты знаешь о нём? Где же он находится?"]},{"code":101,"indent":0,"parameters":["Actor1",4,0,2,"Тодд"]},{"code":401,"indent":0,"parameters":["Да прямо в вагоне-ресторане, я не понимаю, "]},{"code":401,"indent":0,"parameters":["почему остальные до сих пор не остановили "]},{"code":401,"indent":0,"parameters":["поезд, но я им очень благодарен за это, ведь "]},{"code":401,"indent":0,"parameters":["пока поезд едет, я могу заниматься делами."]},{"code":101,"indent":0,"parameters":["Actor1",0,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Тебе не кажется, что ты и жизни-то не ощущаешь? "]},{"code":401,"indent":0,"parameters":["Ты же всё пытаешься сделать идеально, "]},{"code":401,"indent":0,"parameters":["ну зачем тебе это?"]},{"code":101,"indent":0,"parameters":["Actor1",4,0,2,"Тодд"]},{"code":401,"indent":0,"parameters":["Ну как зачем, я же хочу добиться больших "]},{"code":401,"indent":0,"parameters":["успехов, а как иначе ты это сделаешь?"]},{"code":101,"indent":0,"parameters":["Actor1",0,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["А тебе самому это нравится?"]},{"code":101,"indent":0,"parameters":["Actor1",4,0,2,"Тодд"]},{"code":401,"indent":0,"parameters":["Я даже и не знаю."]},{"code":101,"indent":0,"parameters":["Actor1",0,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Вот в этом и дело. Ты даже не знаешь, зачем это "]},{"code":401,"indent":0,"parameters":["делаешь, хочется сделать идеально только "]},{"code":401,"indent":0,"parameters":["потому, что так надо. "]},{"code":101,"indent":0,"parameters":["Actor1",0,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["А кому это действительно нужно? У тебя это уже "]},{"code":401,"indent":0,"parameters":["как привычка, ты тут и обустроил свою "]},{"code":401,"indent":0,"parameters":["зону комфорта."]},{"code":101,"indent":0,"parameters":["people",5,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Причём ты знаешь, что выйти можно, просто "]},{"code":401,"indent":0,"parameters":["боишься это сделать?"]},{"code":101,"indent":0,"parameters":["Actor1",4,0,2,"Тодд"]},{"code":401,"indent":0,"parameters":["Да я, боюсь? Ну не сказал бы, я просто не хочу."]},{"code":101,"indent":0,"parameters":["people",5,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Давай посмотрим правде в глаза: тебе сложно "]},{"code":401,"indent":0,"parameters":["выходить из зоны комфорта, я это понимаю, но "]},{"code":401,"indent":0,"parameters":["сам посуди, жизнь это не черновик, нужно "]},{"code":401,"indent":0,"parameters":["действовать здесь и сейчас."]},{"code":101,"indent":0,"parameters":["people",5,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Нужно показывать настоящего себя, а не работать "]},{"code":401,"indent":0,"parameters":["на износ ради тех вещей, которые никто даже "]},{"code":401,"indent":0,"parameters":["не заметит."]},{"code":101,"indent":0,"parameters":["people",5,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Давай же дёрнем стоп-кран, "]},{"code":401,"indent":0,"parameters":["ведь жизнь надо жить!"]},{"code":101,"indent":0,"parameters":["Actor1",4,0,2,"Тодд"]},{"code":401,"indent":0,"parameters":["Ты правда так считаешь?"]},{"code":101,"indent":0,"parameters":["people",5,0,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Ну конечно, я же сам так и сделал, у меня был "]},{"code":401,"indent":0,"parameters":["дом, работа, но это так надоело, я захотел "]},{"code":401,"indent":0,"parameters":["поп
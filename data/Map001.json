{"id":1,"name":"Соковыжимальщик","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Actor3","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":111,"indent":0,"parameters":[2,"A",0]},{"code":101,"indent":1,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":1,"parameters":["У вас тут… уютно. Зелёно, свежо."]},{"code":101,"indent":1,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":1,"parameters":["Тут-то? Юноша, знал бы ты, как хорошо-то было "]},{"code":401,"indent":1,"parameters":["раньше. Когда я только приехал сюда, "]},{"code":401,"indent":1,"parameters":["всё ещё цвело."]},{"code":101,"indent":1,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":1,"parameters":["А теперь? Остались-то пара несчастных фруктов, "]},{"code":401,"indent":1,"parameters":["да, может, ягод."]},{"code":101,"indent":1,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":1,"parameters":["Всё равно ничего из них не смешать уже."]},{"code":101,"indent":1,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":1,"parameters":["Смешать?"]},{"code":101,"indent":1,"parameters":["",0,2,2,""]},{"code":401,"indent":1,"parameters":["* Мужчина закатывает глаза. *"]},{"code":101,"indent":1,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":1,"parameters":["Смешать. Выжималку видишь? Вот туда фрукты "]},{"code":401,"indent":1,"parameters":["кладёшь и жмёшь. Оно выжимается."]},{"code":101,"indent":1,"parameters":["",0,2,2,""]},{"code":401,"indent":1,"parameters":["* В центре комнаты и впрямь стоит автомат, похожий на "]},{"code":401,"indent":1,"parameters":["соковыжималку. Вокруг него вьются лианы и зелень, будто весь "]},{"code":401,"indent":1,"parameters":["вагон был заброшен много лет назад.*"]},{"code":101,"indent":1,"parameters":["",0,2,2,""]},{"code":401,"indent":1,"parameters":["* Некоторые участки ещё дают плоды. *"]},{"code":101,"indent":1,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":1,"parameters":["Как выжмется, оно закупорит и выдаст тебе банку "]},{"code":401,"indent":1,"parameters":["с соком. Мои рецепты… Я помню всего пару из "]},{"code":401,"indent":1,"parameters":["них. Старые записи… уже не прочитать."]},{"code":101,"indent":1,"parameters":["",0,2,2,""]},{"code":401,"indent":1,"parameters":["* Присмотревшись поближе, Фроск замечает странные символы на "]},{"code":401,"indent":1,"parameters":["фруктах, похожие на буквы. Разбросанные на полу банки имеют "]},{"code":401,"indent":1,"parameters":["простые надписи: \"LOSS\", \"RAGE\", \"DESPAIR\"."]},{"code":111,"indent":1,"parameters":[0,2,1]},{"code":101,"indent":2,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":2,"parameters":["А... какой у вас из этих банок сок любимый?"]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["Любимый, ээ... Забыл, как называется."]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Он достаёт потёртую книжку из внутреннего кармана куртки и "]},{"code":401,"indent":2,"parameters":["листает её. *"]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["А, вот. \"HATRED\"."]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Х-А-Т-Р-Е-Д. Его побуквенное произношение звучит очень "]},{"code":401,"indent":2,"parameters":["уверенно, и абсолютно неверно. *"]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["Не знаю, правда, что оно там значит, на "]},{"code":401,"indent":2,"parameters":["татарском-то. Но на вкус неплохое."]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["В моей семье часто его варили-то, да. Отец меня "]},{"code":401,"indent":2,"parameters":["научил, а его – его отец."]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Он убирает книжку в карман. Бережно, словно боится, что с "]},{"code":401,"indent":2,"parameters":["одного неловкого движения она рассыплется в прах. *"]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Может, так и есть. *"]},{"code":101,"indent":2,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":2,"parameters":["А почему не попробуешь что-то... новенькое?"]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Он тяжело вздыхает. *"]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["Зачем?"]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Его голос звучит... вымученно. *"]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["Это – семейное дело, юноша. Не дорос ты ещё, "]},{"code":401,"indent":2,"parameters":["чтоб понять."]},{"code":0,"indent":2,"parameters":[]},{"code":411,"indent":1,"parameters":[]},{"code":101,"indent":2,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":2,"parameters":["Вот, попробуйте."]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Мужчина хмуро принимает банку. Очевидно, ему не нравится "]},{"code":401,"indent":2,"parameters":["то, что незнакомец пользуется его устройством без "]},{"code":401,"indent":2,"parameters":["разрешения. Но он молчит. *"]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Возможно, он боится, что незнакомец обидится и уйдёт? *"]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Он ничего не говорит и пробует напиток на вкус. *"]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* ... *"]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["На вкус… необычно, конечно. Не помню, чтобы "]},{"code":401,"indent":2,"parameters":["такое пробовал."]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["Напоминает мне что-то. Не помню."]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Он пробует напиток снова. Проходит несколько секунд, "]},{"code":401,"indent":2,"parameters":["прежде чем он снова говорит. *"]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["Знаешь... здесь, из вагона, иногда видно, как "]},{"code":401,"indent":2,"parameters":["солнце садится. Ты, в общем... "]},{"code":401,"indent":2,"parameters":["заходи ещё, как-нибудь."]},{"code":101,"indent":2,"parameters":["",0,2,2,""]},{"code":401,"indent":2,"parameters":["* Мужчина неловко улыбается. *"]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["Надеюсь, мы ещё встретимся."]},{"code":101,"indent":2,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":2,"parameters":["Я думаю искать способ уйти с поезда, хочу "]},{"code":401,"indent":2,"parameters":["сильно изменить свою жизнь, ты со мной?"]},{"code":101,"indent":2,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":2,"parameters":["* Наверное... *"]},{"code":121,"indent":2,"parameters":[3,3,0]},{"code":0,"indent":2,"parameters":[]},{"code":412,"indent":1,"parameters":[]},{"code":0,"indent":1,"parameters":[]},{"code":411,"indent":0,"parameters":[]},{"code":101,"indent":1,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":1,"parameters":["Здравствуйте."]},{"code":101,"indent":1,"parameters":["",0,2,2,""]},{"code":401,"indent":1,"parameters":["* Мужчина поднимает глаза. Он не выглядит старше тридцати, "]},{"code":401,"indent":1,"parameters":["хотя его взгляд стареет его лет на десять. *"]},{"code":101,"indent":1,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":1,"parameters":["Не знал, что здесь кто-то ещё есть. "]},{"code":401,"indent":1,"parameters":["Ну, на поезде-то."]},{"code":101,"indent":1,"parameters":["",0,2,2,""]},{"code":401,"indent":1,"parameters":["* Он поёживается. *"]},{"code":101,"indent":1,"parameters":["Actor1",4,2,2,"Соковыжимальщик"]},{"code":401,"indent":1,"parameters":["Ну… как там, в общем. Привет."]},{"code":101,"indent":1,"parameters":["",0,2,2,""]},{"code":401,"indent":1,"parameters":["* … *"]},{"code":123,"indent":1,"parameters":["A",0]},{"code":0,"indent":1,"parameters":[]},{"code":412,"indent":0,"parameters":[]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":3,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Actor3","direction":2,"pattern":0,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["Actor1",0,2,2,"Фроск"]},{"code":401,"indent":0,"parameters":["Мне нужно двигаться дальше."]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":11,"y":4},
